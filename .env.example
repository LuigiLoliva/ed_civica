# =============================================================================
# Voci Unite — variabili d'ambiente
# Copia questo file in `.env.local` e compila i valori dal tuo progetto Supabase.
# NON committare mai `.env.local` né chiavi service_role.
# =============================================================================

# URL pubblico del sito (locale o produzione Vercel)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Solo server (Server Actions, seed, moderazione). Non esporre al client.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Cloudflare Turnstile (anti-spam commenti) — stub se assenti / BYPASS=true
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_BYPASS=true

# Sale per hash IP nei commenti (non esporre)
COMMENT_IP_HASH_SALT=cambia-in-produzione

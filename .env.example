# =============================================================================
# Voci Unite — variabili d'ambiente
# Copia questo file in `.env.local` e compila i valori dal TUO progetto.
# NON inventare secret. NON committare `.env.local` né chiavi service_role.
# =============================================================================

# URL pubblico del sito (locale o produzione Vercel)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API
# Sostituisci con URL e chiavi reali dal tuo progetto (nessun placeholder inventato).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo server (Server Actions, seed, moderazione). Non esporre al client.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile (anti-spam commenti)
# In sviluppo: senza chiavi la verifica viene saltata (avviso in console).
# In produzione: TURNSTILE_SECRET_KEY è obbligatoria.
# TURNSTILE_BYPASS=true è ignorato in produzione.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_BYPASS=true

# Sale per hash IP nei commenti (scegline una lunga e casuale in produzione)
COMMENT_IP_HASH_SALT=

# Email opzionali (Resend) per registrazione / approvazione studenti.
# Se assenti, il flusso funziona comunque (badge in /admin/utenti).
# Non inventare chiavi: usa solo quelle del tuo account Resend.
RESEND_API_KEY=
RESEND_FROM=
